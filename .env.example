# Copy this file to .env and fill in your real values. Never commit .env itself.

# Supabase connection string (Project Settings > Database > Connection string > URI)
# Use the "Transaction pooler" URI for short-lived processes like this test harness.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-region.pooler.supabase.com:6543/postgres

# Only needed once you swap MockLlmClient for AnthropicLlmClient in the harness.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
